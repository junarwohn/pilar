[Unit]
Description=Pilar Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/workspace/pilar
Environment="PORT=8000"
Environment="RESULT_RETENTION_DAYS=7"
Environment="PILAR_CLEANUP_OLD_RESULTS=1"
EnvironmentFile=-/home/YOUR_USER/workspace/pilar/.env
Environment="PATH=/home/YOUR_USER/workspace/pilar/pilar-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/YOUR_USER/workspace/pilar/run-web.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
